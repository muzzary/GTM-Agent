# Local FastAPI application
GTM_APP_ENV=development
GTM_API_HOST=127.0.0.1
GTM_API_PORT=8000

# Required only when running approved live public research.
GTM_RESEARCH_CONTACT=your-email-or-public-contact-url
GTM_RESEARCH_CACHE_PATH=data/research-cache.sqlite3

# Optional: use the fine-tuned Colab model for English research summaries.
# Keep the real key only in your local .env and Colab secret storage.
GTM_TRANSLATION_ENDPOINT=https://your-colab-tunnel.example/translate
GTM_TRANSLATION_API_KEY=replace-with-a-long-random-secret
