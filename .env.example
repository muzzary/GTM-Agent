# Local FastAPI application
GTM_APP_ENV=development
GTM_API_HOST=127.0.0.1
GTM_API_PORT=8000

# Required only when running approved live public research.
GTM_RESEARCH_CONTACT=your-email-or-public-contact-url
GTM_RESEARCH_CACHE_PATH=data/research-cache.sqlite3

# Colab credentials belong in Colab secret storage, not this local template.
# The MVP exchanges reviewed inference-result bundles rather than API secrets.
